{
  "name": "hydarium-launcher",
  "version": "0.10.52",
  "description": "Hydarium – le launcher Minecraft simple, beau et communautaire",
  "author": "Hydarium",
  "homepage": "https://github.com/Gazein21/hydarium#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazein21/hydarium.git"
  },
  "bugs": {
    "url": "https://github.com/Gazein21/hydarium/issues"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "node scripts/fetch-jre.js && electron-builder --win --publish never",
    "dist:mac": "node scripts/fetch-jre.js && electron-builder --mac --publish never",
    "dist:linux": "node scripts/fetch-jre.js && electron-builder --linux --publish never",
    "build:mods": "node scripts/build-mods.js",
    "test": "node test/version.test.js && node test/modplan.test.js && node test/clientfirst.test.js && node test/modbuild.test.js && node test/crash.test.js && node test/playit.test.js && node test/p2p.test.js && node test/legacyports.test.js && node test/jre.test.js && node test/core-compile.test.js && node --test test/forgegen.test.js && node test/worldexport.test.js && node test/skins.test.js && node test/updater.test.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.11",
    "hyperdht": "^6.36.0",
    "minecraft-launcher-core": "^3.18.0",
    "msmc": "^5.0.0",
    "nat-upnp": "^1.1.1",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "rcedit": "^3.0.1"
  },
  "build": {
    "appId": "fr.hydarium.launcher",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "productName": "Hydarium",
    "publish": [
      {
        "provider": "github",
        "owner": "Gazein21",
        "repo": "hydarium"
      }
    ],
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "!node_modules/sodium-native/prebuilds/android-*/**",
      "!node_modules/sodium-native/prebuilds/ios-*/**",
      "!node_modules/udx-native/prebuilds/android-*/**",
      "!node_modules/udx-native/prebuilds/ios-*/**"
    ],
    "extraResources": [
      {
        "from": "build-jre/jre",
        "to": "jre"
      },
      {
        "from": "build-client",
        "to": "client",
        "filter": [
          "*.jar",
          "hydarium-*.json"
        ]
      },
      {
        "from": "client-mod",
        "to": "mod-src/client-mod",
        "filter": [
          "**/*",
          "!**/build/**",
          "!**/.gradle/**",
          "!**/run/**",
          "!**/out/**"
        ]
      },
      {
        "from": "scripts",
        "to": "mod-src/scripts",
        "filter": [
          "build-mods.js",
          "util.js"
        ]
      },
      {
        "from": "src/main/modplan.js",
        "to": "mod-src/scripts/modplan.js"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis-web",
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Hydarium-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "uninstallDisplayName": "Hydarium",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "nsisWeb": {
      "artifactName": "Hydarium-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Hydarium-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
